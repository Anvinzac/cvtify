# AI Suggestions Configuration
# OpenAI-compatible endpoint for generating professional CV descriptions
# User can also configure these at runtime via localStorage

# API endpoint (OpenAI-compatible)
# Examples:
#   - OpenAI: https://api.openai.com
#   - Azure OpenAI: https://YOUR_RESOURCE.openai.azure.com
#   - Local/Custom: http://localhost:11434 (Ollama)
VITE_AI_ENDPOINT=

# API key for authentication
VITE_AI_API_KEY=

# Model name (optional, defaults to gpt-4o-mini)
# Examples: gpt-4o, gpt-4o-mini, gpt-3.5-turbo, llama3.1
VITE_AI_MODEL=
